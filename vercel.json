{
  "outputDirectory": ".",
  "framework": null,
  "installCommand": "echo done",
  "buildCommand": "echo done",
  "headers": [
    {
      "source": "/(.*) 일반자금대출",
      "headers": [
        {
          "key": "X-Hackathon-Disclaimer",
          "value": "Built as a concept for the Paytm Hackathon. Not an official Paytm product."
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/static/(.*)", "destination": "/static/$1" },
    { "source": "/report/baseline", "destination": "https://paytm-recovery-agent.onrender.com/report/baseline" },
    { "source": "/report", "destination": "https://paytm-recovery-agent.onrender.com/report" },
    { "source": "/cases/(.*)", "destination": "https://paytm-recovery-agent.onrender.com/cases/$1" },
    { "source": "/security/(.*)", "destination": "https://paytm-recovery-agent.onrender.com/security/$1" },
    { "source": "/analytics/(.*)", "destination": "https://paytm-recovery-agent.onrender.com/analytics/$1" },
    { "source": "/budget", "destination": "https://paytm-recovery-agent.onrender.com/budget" },
    { "source": "/incidents", "destination": "https://paytm-recovery-agent.onrender.com/incidents" },
    { "source": "/approval/(.*)", "destination": "https://paytm-recovery-agent.onrender.com/approval/$1" },
    { "source": "/calculator(.*)", "destination": "https://paytm-recovery-agent.onrender.com/calculator$1" },
    { "source": "/batch/(.*)", "destination": "https://paytm-recovery-agent.onrender.com/batch/$1" },
    { "source": "/inbound/(.*)", "destination": "https://paytm-recovery-agent.onrender.com/inbound/$1" },
